# Set to 1 to run without Gmail credentials (seeded sample inbox, nothing real is touched)
LAYAMAIL_DEMO=0
# laya | heuristic   (heuristic is a keyword fallback; its confidence is capped so it never auto-trashes)
LAYAMAIL_CLASSIFIER=laya
# Laya checkpoint routing: the Router picks English/multilingual automatically
LAYAMAIL_DB=layamail.db
LAYAMAIL_CREDENTIALS=credentials.json
LAYAMAIL_TOKEN=token.json
# Only set to 1 if you want the optional "permanent delete" feature. Requires the broad
# https://mail.google.com/ scope: delete token.json and sign in again after changing this.
LAYAMAIL_PERMANENT_DELETE=0
